# Formato Docker --env-file: valores literales, sin comillas ni export.
DISCOURSE_HOSTNAME=comunidad.hefesto-studio.cl
DISCOURSE_DEVELOPER_EMAILS=REEMPLAZAR@example.invalid
DISCOURSE_DEFAULT_LOCALE=es
DISCOURSE_SMTP_ADDRESS=REEMPLAZAR
DISCOURSE_SMTP_PORT=465
DISCOURSE_SMTP_USER_NAME=REEMPLAZAR
DISCOURSE_SMTP_PASSWORD=REEMPLAZAR
DISCOURSE_SMTP_FORCE_TLS=true
DISCOURSE_SMTP_ENABLE_START_TLS=false
DISCOURSE_SMTP_OPENSSL_VERIFY_MODE=peer
DISCOURSE_NOTIFICATION_EMAIL=comunidad@hefesto-studio.cl
